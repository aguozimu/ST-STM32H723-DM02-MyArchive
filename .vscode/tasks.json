{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure Debug",
            "type": "process",
            "command": "E:/CubeCLT/STM32CubeCLT_1.22.0/CMake/bin/cmake.exe",
            "args": [
                "--preset",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/H7_BSP-main"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Build Debug",
            "type": "process",
            "command": "E:/CubeCLT/STM32CubeCLT_1.22.0/CMake/bin/cmake.exe",
            "args": [
                "--build",
                "--preset",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/H7_BSP-main"
            },
            "dependsOn": "CMake: Configure Debug",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "DAPLink: Flash Debug",
            "type": "process",
            "command": "E:/OpenOCD/xpack-openocd-0.12.0-7-win32-x64/xpack-openocd-0.12.0-7/bin/openocd.exe",
            "args": [
                "-s",
                "E:/OpenOCD/xpack-openocd-0.12.0-7-win32-x64/xpack-openocd-0.12.0-7/openocd/scripts",
                "-f",
                "User_Config/daplink.cfg",
                "-c",
                "program build/Debug/H7_BSP.elf verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}/H7_BSP-main"
            },
            "problemMatcher": []
        },
        {
            "label": "DAPLink: Reset Target",
            "type": "process",
            "command": "E:/OpenOCD/xpack-openocd-0.12.0-7-win32-x64/xpack-openocd-0.12.0-7/bin/openocd.exe",
            "args": [
                "-s",
                "E:/OpenOCD/xpack-openocd-0.12.0-7-win32-x64/xpack-openocd-0.12.0-7/openocd/scripts",
                "-f",
                "User_Config/daplink.cfg",
                "-c",
                "init; reset run; shutdown"
            ],
            "options": {
                "cwd": "${workspaceFolder}/H7_BSP-main"
            },
            "problemMatcher": []
        }
    ]
}
