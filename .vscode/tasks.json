{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/H7_BSP-main"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: build Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug",
                "--parallel"
            ],
            "options": {
                "cwd": "${workspaceFolder}/H7_BSP-main"
            },
            "dependsOn": "CMake: configure Debug",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMake: configure Release",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/H7_BSP-main"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: build Release",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Release",
                "--parallel"
            ],
            "options": {
                "cwd": "${workspaceFolder}/H7_BSP-main"
            },
            "dependsOn": "CMake: configure Release",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "Flash STM32H723 via DAPLink",
            "type": "process",
            "command": "C:/Users/zyj/AppData/Roaming/xPacks/@xpack-dev-tools/openocd/0.12.0-7.1/.content/bin/openocd.exe",
            "args": [
                "-s",
                "C:/Users/zyj/AppData/Roaming/xPacks/@xpack-dev-tools/openocd/0.12.0-7.1/.content/openocd/scripts",
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/stm32h7x.cfg",
                "-c",
                "transport select swd",
                "-c",
                "adapter speed 1000",
                "-c",
                "program build/Debug/H7_BSP.elf verify reset exit"
            ],
            "dependsOn": "CMake: build Debug",
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${workspaceFolder}/H7_BSP-main"
            },
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Flash STM32H723 via ST-Link",
            "type": "process",
            "command": "C:/Users/zyj/AppData/Roaming/xPacks/@xpack-dev-tools/openocd/0.12.0-7.1/.content/bin/openocd.exe",
            "args": [
                "-s",
                "C:/Users/zyj/AppData/Roaming/xPacks/@xpack-dev-tools/openocd/0.12.0-7.1/.content/openocd/scripts",
                "-f",
                "interface/stlink.cfg",
                "-f",
                "target/stm32h7x.cfg",
                "-c",
                "program build/Debug/H7_BSP.elf verify reset exit"
            ],
            "dependsOn": "CMake: build Debug",
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${workspaceFolder}/H7_BSP-main"
            },
            "group": {
                "kind": "build"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}