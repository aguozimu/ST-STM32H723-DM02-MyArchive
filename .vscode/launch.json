{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32H723: DAPLink (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}/H7_BSP-main",
            "executable": "${workspaceFolder}/H7_BSP-main/build/Debug/H7_BSP.elf",
            "servertype": "openocd",
            "interface": "swd",
            "gdbPath": "C:/ST/STM32CubeCLT_1.18.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb.exe",
            "serverpath": "C:/Users/zyj/AppData/Roaming/xPacks/@xpack-dev-tools/openocd/0.12.0-7.1/.content/bin/openocd.exe",
            "searchDir": [
                "C:/Users/zyj/AppData/Roaming/xPacks/@xpack-dev-tools/openocd/0.12.0-7.1/.content/openocd/scripts"
            ],
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32h7x.cfg"
            ],
            "openOCDLaunchCommands": [
                "transport select swd",
                "adapter speed 1000"
            ],
            "device": "STM32H723VGTx",
            "runToEntryPoint": "main",
            "preLaunchTask": "CMake: build Debug"
        },
        {
